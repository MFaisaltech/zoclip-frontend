# Public browser configuration ONLY; all SET_* values need owner review before deployment.
NEXT_PUBLIC_PRIVATE_STAGING=true
NEXT_PUBLIC_ENABLE_REGISTRATION=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_STAGING_SITE_DOMAIN=SET_OWNED_DOMAIN
NEXT_PUBLIC_APP_ORIGIN=https://SET_FRONTEND_HOST
NEXT_PUBLIC_API_ORIGIN=https://SET_API_HOST:8443
NEXT_TELEMETRY_DISABLED=1
